# Copy this to apps/storefront/.env.local and apps/backoffice/.env.local
# (Vite only reads .env files from the app's own root, so each app needs its own copy.)
# Get these values from Firebase Console -> Project settings -> General -> Your apps -> SDK setup.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
