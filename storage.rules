rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/staffUsers/$(request.auth.uid));
    }
    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/staffUsers/$(request.auth.uid));
    }
    match /slides/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.exists(/databases/(default)/documents/staffUsers/$(request.auth.uid));
    }
  }
}
